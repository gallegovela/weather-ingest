AEMET_API_KEY=

# Cadena de conexión a PostgreSQL usada por Alembic (db/) y por la app.
# Formato: postgresql+psycopg://usuario:password@host:5432/bd
DATABASE_URL=

# Minutos de validez de una sesión del panel de control desde el login,
# sin renovación (por defecto 15 si no se define).
CONTROL_SESSION_TTL_MINUTOS=
